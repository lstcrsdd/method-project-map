{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectmap.dev/schemas/pmf-v0.schema.json",
  "title": "Project Map Format (PMF) v0 Schema",
  "description": "JSON Schema for Project Map Format v0 supporting design maps, actual maps, and combined maps.",
  "type": "object",
  "required": [
    "pmf_version",
    "kind"
  ],
  "properties": {
    "pmf_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the PMF specification (e.g., 0.1.0)."
    },
    "kind": {
      "type": "string",
      "enum": [
        "design",
        "actual",
        "combined"
      ],
      "description": "Map flavor: 'design' (authored by human), 'actual' (generated by static scanner), or 'combined'."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the actual map was generated."
    },
    "repo_root": {
      "type": "string",
      "description": "Normalized path or identifier of the scanned repository root."
    },
    "scanner": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "subsystems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Subsystem"
      }
    },
    "allowed_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AllowedDependency"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActualNode"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActualEdge"
      }
    },
    "import_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Import roots (relative POSIX paths) used to derive module names; '.' is the repository root."
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScanError"
      },
      "description": "Files the scanner could not analyse; they are absent from nodes and edges."
    },
    "languages": {
      "type": "object",
      "description": "Source files per language and whether they are on the map (other languages need the optional tree-sitter grammars).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "mapped": {
            "type": "boolean"
          }
        },
        "required": [
          "files",
          "mapped"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "design"
          }
        }
      },
      "then": {
        "required": [
          "project",
          "subsystems",
          "allowed_dependencies"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "actual"
          }
        }
      },
      "then": {
        "required": [
          "generated_at",
          "scanner",
          "nodes",
          "edges"
        ]
      }
    }
  ],
  "$defs": {
    "Subsystem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Glob patterns mapping repository file paths to this subsystem."
        }
      },
      "additionalProperties": false
    },
    "AllowedDependency": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Source subsystem ID."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "Target subsystem ID that 'from' is allowed to depend on."
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CodeLocation": {
      "type": "object",
      "required": [
        "path",
        "line_start",
        "line_end",
        "file_hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative POSIX file path from repository root."
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "file_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 hash of the file content prefixed with 'sha256:'."
        }
      },
      "additionalProperties": false
    },
    "ActualNode": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "qualified_name",
        "external"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "module",
            "class",
            "function",
            "method"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "external": {
          "type": "boolean"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "docstring_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "external": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "location"
            ],
            "properties": {
              "location": {
                "$ref": "#/$defs/CodeLocation"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "EdgeLocation": {
      "type": "object",
      "required": [
        "path",
        "line"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ActualEdge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "kind",
        "confidence",
        "source"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Origin node ID."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "Target node ID. Special forms: 'unresolved:<expr>' (confidence unresolved), 'unresolved:import:<module>' (import that could not be resolved), 'ambiguous:<expr>' (confidence inferred with several candidates)."
        },
        "kind": {
          "type": "string",
          "enum": [
            "contains",
            "imports",
            "calls",
            "inherits"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "resolved",
            "inferred",
            "unresolved"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the static analyzer that produced this edge (e.g. 'python-ast-v0')."
        },
        "target_symbol": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional symbol expression or imported name referenced by this edge."
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/EdgeLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Possible target node IDs of an inferred edge."
        },
        "type_only": {
          "type": "boolean",
          "description": "True for imports executed only under typing.TYPE_CHECKING (not a runtime dependency)."
        }
      },
      "additionalProperties": false
    },
    "ScanError": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "syntax_error",
            "decode_error",
            "duplicate_module",
            "partial_parse"
          ]
        },
        "message": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "file_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
